# ==============================================================================
# === Harness AI Agent — Environment Variables =================================
# ==============================================================================
# Copie este arquivo para .env e preencha suas chaves e preferências.
# O harness carrega automaticamente o arquivo .env na inicialização.

# === Controles do Agente ======================================================
# Define o provedor e modelo padrão ativos na inicialização
# HARNESS_PROVIDER=deepseek  # Opções: gemini, deepseek, openai, anthropic, groq, ollama, etc.
# HARNESS_MODEL=deepseek-v4-flash

# === Gemini (Google) ==========================================================
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-1.5-pro"
# GEMINI_WEB_MODEL="gemini-2.0-flash-exp" # Usado para grounding de busca web

# === DeepSeek =================================================================
DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# === OpenAI ===================================================================
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# === Anthropic (Claude) =======================================================
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# === Groq =====================================================================
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_BASE_URL="https://api.groq.com/openai/v1"

# === Ollama (Modelos Locais) ==================================================
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODEL="llama3"

# === Provedores OpenAI-Compatíveis (via GenericOpenAIProvider) =================
# O modelo dinâmico é resolvido via [NOME]_MODEL e [NOME]_BASE_URL se vazios

# OpenRouter
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="anthropic/claude-sonnet-4"

# Together AI
TOGETHER_API_KEY=""
# TOGETHER_MODEL="meta-llama/Llama-3.3-70B-Instruct-Turbo"

# Fireworks AI
FIREWORKS_API_KEY=""
# FIREWORKS_MODEL="accounts/fireworks/models/llama-v3p3-70b-instruct"

# Mistral AI
MISTRAL_API_KEY=""
# MISTRAL_MODEL="mistral-large-latest"

# xAI (Grok)
XAI_API_KEY=""
# XAI_MODEL="grok-2"

# Cerebras
CEREBRAS_API_KEY=""
# CEREBRAS_MODEL="llama3.1-8b"

# DeepInfra
DEEPINFRA_API_KEY=""
# DEEPINFRA_MODEL="meta-llama/Meta-Llama-3.1-70B-Instruct"

# Hugging Face
HF_API_KEY=""
# HF_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# === Web Search ===============================================================
PERPLEXITY_API_KEY=""
EXA_API_KEY=""

# === Code Search ==============================================================
# GitHub Token: opcional, aumenta rate limit de 60 para 5000 req/hora
GITHUB_TOKEN=""
