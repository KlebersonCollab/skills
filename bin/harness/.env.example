# === Harness AI Agent — Environment Variables ===
# Copie este arquivo para .env e preencha suas chaves
# O harness carrega automaticamente na inicialização
# Todos os provedores OpenAI-compatíveis usam o mesmo formato de API

# === LLM Providers Principais ===
# Pelo menos UM precisa estar configurado

# Gemini (Google) — suporta search grounding
GEMINI_API_KEY=""

# DeepSeek — ótimo custo-benefício
DEEPSEEK_API_KEY=""

# OpenAI (GPT-4o, GPT-4, o3, etc.)
OPENAI_API_KEY=""

# Anthropic (Claude Sonnet, Opus, Haiku)
ANTHROPIC_API_KEY=""

# Groq — inferência ultra-rápida (Llama, Mixtral, DeepSeek)
GROQ_API_KEY=""

# Ollama — modelos locais (Llama, DeepSeek, Qwen, etc.)
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODEL="llama3"

# === Providers OpenAI-Compatíveis (via GenericOpenAIProvider) ===
# Basta configurar a chave + model (opcional)

# OpenRouter — roteia entre vários modelos
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="anthropic/claude-sonnet-4"

# Together AI — Llama, Mixtral, DeepSeek hospedados
TOGETHER_API_KEY=""
# TOGETHER_MODEL="meta-llama/Llama-3.3-70B-Instruct-Turbo"

# Fireworks AI — inferência rápida
FIREWORKS_API_KEY=""
# FIREWORKS_MODEL="accounts/fireworks/models/llama-v3p3-70b-instruct"

# Mistral AI — modelos Mistral, Codestral
MISTRAL_API_KEY=""
# MISTRAL_MODEL="mistral-large-latest"

# xAI (Grok)
XAI_API_KEY=""
# XAI_MODEL="grok-2"

# Cerebras — inferência ultra-rápida
CEREBRAS_API_KEY=""
# CEREBRAS_MODEL="llama3.1-8b"

# DeepInfra — Llama, Mixtral, Qwen
DEEPINFRA_API_KEY=""
# DEEPINFRA_MODEL="meta-llama/Meta-Llama-3.1-70B-Instruct"

# Hugging Face Inference API
HF_API_KEY=""
# HF_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# === Web Search ===
PERPLEXITY_API_KEY=""
EXA_API_KEY=""

# === Code Search ===
# GitHub Token: opcional, aumenta rate limit de 60 para 5000 req/hora
GITHUB_TOKEN=""
